generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// 1. Пользователи (Клиенты, Продавцы, Админы)
model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  phone         String?   @unique
  password      String?
  role          Role      @default(CLIENT)
  status        String    @default("ACTIVE") 
  birthDate     DateTime?
  branch        String?   
  hireDate      DateTime?
  lastLogin     DateTime?
  notes         String?   
  
  bookings      Booking[]
  orders        Order[]
  reviews       Review[]
  favorites     Favorite[]
  digitalReqs   DigitalRequest[]
  tradeInReqs   TradeInRequest[]
  
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

enum Role {
  CLIENT
  SELLER
  ADMIN
}

// 2. Категории (Рекурсивные)
model Category {
  id          String     @id @default(cuid())
  name        String
  slug        String     @unique
  description String?    
  parentId    String?
  parent      Category?  @relation("SubCategories", fields: [parentId], references: [id])
  children    Category[] @relation("SubCategories")
  
  products    Product[]
  
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
}

// 3. Товары
model Product {
  id              String       @id @default(cuid())
  sku             String       @unique 
  name            String
  description     String?
  priceCash       Int          
  priceCard       Int          
  condition       String       
  completeness    String?      
  warranty        String?      
  availability    Availability @default(OUT_OF_STOCK)
  
  isSpecialOffer  Boolean      @default(false) 
  isPreorder      Boolean      @default(false) 
  maxBookingHours Int          @default(24)    
  
  specs           Json?        
  
  images          String[]     
  videoUrl        String?
  
  categoryId      String
  category        Category     @relation(fields: [categoryId], references: [id])
  
  favorites       Favorite[]
  bookingItems    BookingItem[]
  orderItems      OrderItem[]
  reviews         Review[]
  
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
}

enum Availability {
  ANGARSK
  IRKUTSK
  BOTH
  ON_ORDER
  OUT_OF_STOCK
}

// 4. Бронирования
model Booking {
  id            String        @id @default(cuid())
  
  userId        String?
  user          User?         @relation(fields: [userId], references: [id])
  
  branch        String        
  status        BookingStatus @default(PENDING)
  comment       String?
  cancelReason  String?       
  
  pickupCode    String?       
  
  guestName     String?
  guestPhone    String?
  guestEmail    String?       
  contactMethod String?
  contactValue  String?
  
  items         BookingItem[]
  expiresAt     DateTime      
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
}

model BookingItem {
  id        String  @id @default(cuid())
  bookingId String
  booking   Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id])
  quantity  Int     @default(1)
}

enum BookingStatus {
  PENDING
  CONFIRMED
  READY
  COMPLETED
  CANCELLED
  EXPIRED
}

// 5. Заказы с доставкой
model Order {
  id            String      @id @default(cuid())
  userId        String?
  user          User?       @relation(fields: [userId], references: [id])
  status        OrderStatus @default(PENDING)
  cancelReason  String?     
  deliveryService String    
  address       String?
  comment       String?
  
  guestName     String?
  guestPhone    String?
  guestEmail    String?     
  contactMethod String?
  contactValue  String?
  
  items         OrderItem[]
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
}

enum OrderStatus {
  PENDING
  PROCESSING
  SHIPPED
  COMPLETED
  CANCELLED
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id])
  price     Int
  quantity  Int     @default(1)
}

// 6. Заявки на цифровые товары
model DigitalRequest {
  id            String   @id @default(cuid())
  userId        String?
  user          User?    @relation(fields: [userId], references: [id])
  gameTitle     String
  console       String
  region        String   
  contactMethod String   
  status        String   @default("NEW")
  createdAt     DateTime @default(now())
}

// 7. Заявки Trade-in
model TradeInRequest {
  id            String   @id @default(cuid())
  userId        String?
  user          User?    @relation(fields: [userId], references: [id])
  deviceToTrade String
  condition     String
  completeness  String?  
  desiredDevice String?  
  contactMethod String
  contactValue  String?  
  
  guestName     String?  // <--- ДОБАВИЛИ ИМЯ
  guestPhone    String?  // <--- ДОБАВИЛИ ТЕЛЕФОН
  
  status        String   @default("NEW")
  createdAt     DateTime @default(now())
}

// 8. Избранное
model Favorite {
  id        String  @id @default(cuid())
  userId    String
  user      User    @relation(fields: [userId], references: [id])
  productId String
  product   Product @relation(fields: [productId], references: [id])
  createdAt DateTime @default(now())
  @@unique([userId, productId])
}

// 9. Отзывы
model Review {
  id        String  @id @default(cuid())
  userId    String
  user      User    @relation(fields: [userId], references: [id])
  productId String
  product   Product @relation(fields: [productId], references: [id])
  rating    Int
  text      String?
  createdAt DateTime @default(now())
}

// 10. Промокоды
model PromoCode {
  id          String   @id @default(cuid())
  code        String   @unique
  discountPct Int?     
  discountAmt Int?     
  isActive    Boolean  @default(true)
  expiresAt   DateTime?
  createdAt   DateTime @default(now())
}

// 11. Услуги ремонта (Прайс)
model RepairService {
  id          String   @id @default(cuid())
  category    String   
  name        String   
  price       Int
  createdAt   DateTime @default(now())
}