generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// 1. Пользователи
model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  phone         String?   @unique
  password      String?
  role          Role      @default(CLIENT)
  status        String    @default("ACTIVE") 
  birthDate     DateTime?
  branch        String?   
  hireDate      DateTime?
  lastLogin     DateTime?
  notes         String?   
  
  bookings      Booking[]
  orders        Order[]
  reviews       Review[]
  favorites     Favorite[]
  digitalReqs   DigitalRequest[]
  tradeInReqs   TradeInRequest[]
  customReqs    CustomRequest[]
  
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

enum Role {
  CLIENT
  SELLER
  ADMIN
}

// 2. Категории
model Category {
  id          String     @id @default(cuid())
  name        String
  slug        String     @unique
  description String?    
  parentId    String?
  parent      Category?  @relation("SubCategories", fields: [parentId], references: [id])
  children    Category[] @relation("SubCategories")
  products    Product[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
}

// 3. Товары
model Product {
  id              String       @id @default(cuid())
  sku             String       @unique 
  name            String
  description     String?
  priceCash       Int          
  priceCard       Int          
  condition       String       
  completeness    String?      
  warranty        String?      
  availability    Availability @default(OUT_OF_STOCK)
  isSpecialOffer  Boolean      @default(false) 
  isPreorder      Boolean      @default(false) 
  maxBookingHours Int          @default(24)    
  specs           Json?        
  images          String[]     
  videoUrl        String?
  
  categoryId      String
  category        Category     @relation(fields: [categoryId], references: [id])
  
  favorites       Favorite[]
  bookingItems    BookingItem[]
  orderItems      OrderItem[]
  reviews         Review[]
  
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
}

enum Availability {
  ANGARSK
  IRKUTSK
  BOTH
  ON_ORDER
  OUT_OF_STOCK
}

// 4. Бронирования
model Booking {
  id            String        @id @default(cuid())
  userId        String?
  user          User?         @relation(fields: [userId], references: [id])
  branch        String        
  status        BookingStatus @default(PENDING)
  comment       String?
  cancelReason  String?       
  pickupCode    String?       
  guestName     String?
  guestPhone    String?
  guestEmail    String?       
  contactMethod String?
  contactValue  String?
  items         BookingItem[]
  expiresAt     DateTime      
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
}

model BookingItem {
  id        String  @id @default(cuid())
  bookingId String
  booking   Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id])
  quantity  Int     @default(1)
}

enum BookingStatus {
  PENDING
  CONFIRMED
  READY
  COMPLETED
  CANCELLED
  EXPIRED
}

// 5. Заказы
model Order {
  id            String      @id @default(cuid())
  userId        String?
  user          User?       @relation(fields: [userId], references: [id])
  status        OrderStatus @default(PENDING)
  cancelReason  String?     
  deliveryService String    
  address       String?
  comment       String?
  pickupCode    String?     
  guestName     String?
  guestPhone    String?
  guestEmail    String?     
  contactMethod String?
  contactValue  String?
  items         OrderItem[]
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
}

enum OrderStatus {
  PENDING
  PROCESSING
  SHIPPED
  COMPLETED
  CANCELLED
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id])
  price     Int
  quantity  Int     @default(1)
}

// 6. Цифровые товары
model DigitalRequest {
  id            String   @id @default(cuid())
  userId        String?
  user          User?    @relation(fields: [userId], references: [id])
  gameTitle     String
  console       String
  region        String   
  accountStatus String?  
  contactMethod String
  contactValue  String?  
  guestName     String?
  guestPhone    String?
  status        String   @default("NEW")
  createdAt     DateTime @default(now())
}

// 7. Trade-in
model TradeInRequest {
  id            String   @id @default(cuid())
  userId        String?
  user          User?    @relation(fields: [userId], references: [id])
  deviceToTrade String
  condition     String
  completeness  String?  
  desiredDevice String?  
  contactMethod String
  contactValue  String?  
  guestName     String?
  guestPhone    String?
  status        String   @default("NEW")
  createdAt     DateTime @default(now())
}

// 8. Кастомные заказы
model CustomRequest {
  id            String   @id @default(cuid())
  userId        String?
  user          User?    @relation(fields: [userId], references: [id])
  productName   String   
  productLink   String?  
  comment       String?  
  guestName     String?
  guestPhone    String?
  contactMethod String
  contactValue  String?
  status        String   @default("NEW") 
  createdAt     DateTime @default(now())
}

// 9. Избранное
model Favorite {
  id        String  @id @default(cuid())
  userId    String
  user      User    @relation(fields: [userId], references: [id])
  productId String
  product   Product @relation(fields: [productId], references: [id])
  createdAt DateTime @default(now())
  @@unique([userId, productId])
}

// 10. Отзывы
model Review {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  productId String
  product   Product  @relation(fields: [productId], references: [id])
  rating    Int
  text      String?
  images    String[] // <--- ДОБАВЛЕНО ПОЛЕ ДЛЯ ФОТОГРАФИЙ
  createdAt DateTime @default(now())
}

// 11. Промокоды
model PromoCode {
  id          String   @id @default(cuid())
  code        String   @unique
  discountPct Int?     
  discountAmt Int?     
  isActive    Boolean  @default(true)
  expiresAt   DateTime?
  createdAt   DateTime @default(now())
}

// 12. Услуги ремонта
model RepairService {
  id          String   @id @default(cuid())
  category    String   
  name        String   
  deviceModel String?  
  price       Int
  isFromPrice Boolean  @default(false)
  priceUnit   String?  
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
}

// 13. Подписки
model SubscriptionPlan {
  id          String @id @default(cuid())
  platform    String 
  region      String 
  tier        String 
  duration    String 
  accountType String? 
  price       Int
  sortOrder   Int    @default(0)
}